<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hethongdaugia</groupId>
    <artifactId>HeThongDauGia</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>HeThongDauGia</name>
    <description>Hệ Thống Đấu Giá - Auction System</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <javafx.version>25</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>

        <junit.jupiter.version>5.8.1</junit.jupiter.version>
        <main.class>view.Launcher</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <options>
                        <option>--enable-native-access=ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>

            <!-- Checkstyle: đổi sang phase verify để target/ đã tồn tại -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>false</failsOnError>
                    <failOnViolation>false</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase> <!-- FIX: đổi từ validate → verify -->
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Tạo fat JAR (jar-with-dependencies) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <finalName>${project.artifactId}-${project.version}</finalName>
                    <appendAssemblyId>true</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy tất cả dependency JAR vào thư mục libs -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire: chạy JUnit 5 đúng cách -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <useModulePath>false</useModulePath>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.fxml</include>
                    <include>**/*.properties</include>
                    <include>**/*.css</include>
                    <include>**/*.xml</include>
                    <include>**/*.jpg</include>
                    <include>**/*.png</include>
                </includes>
            </resource>
        </resources>

        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <includes>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                </includes>
            </testResource>
        </testResources>
    </build>

    <profiles>
        <!-- PROFILE CHO WINDOWS -->
        <profile>
            <id>package-windows</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/client-package-input" quiet="true"/>
                                        <delete dir="${project.build.directory}/server-package-input" quiet="true"/>
                                        <delete dir="${project.build.directory}/dist" quiet="true"/>
                                        <mkdir dir="${project.build.directory}/client-package-input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/client-package-input/client.jar"/>
                                        <copy todir="${project.build.directory}/client-package-input">
                                            <fileset dir="${project.build.directory}/libs"/>
                                        </copy>
                                        <mkdir dir="${project.build.directory}/server-package-input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/server-package-input/server.jar"/>
                                        <copy todir="${project.build.directory}/server-package-input">
                                            <fileset dir="${project.build.directory}/libs"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-client</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>app-image</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/client-package-input</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--name</argument><argument>HeThongDauGiaClient</argument>
                                        <argument>--main-jar</argument><argument>client.jar</argument>
                                        <argument>--main-class</argument><argument>view.Launcher</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--app-version</argument><argument>${project.version.clean}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-server</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>app-image</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/server-package-input</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--name</argument><argument>HeThongDauGiaServer</argument>
                                        <argument>--main-jar</argument><argument>server.jar</argument>
                                        <argument>--main-class</argument><argument>server.AuctionServer</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <!-- Bật console cho server trên windows -->
                                        <argument>--win-console</argument>
                                        <argument>--app-version</argument><argument>${project.version.clean}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties><project.version.clean>1.0.0</project.version.clean></properties>
        </profile>

        <!-- PROFILE CHO MACOS -->
        <profile>
            <id>package-mac</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/client-package-input" quiet="true"/>
                                        <delete dir="${project.build.directory}/server-package-input" quiet="true"/>
                                        <delete dir="${project.build.directory}/dist" quiet="true"/>
                                        <mkdir dir="${project.build.directory}/client-package-input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/client-package-input/client.jar"/>
                                        <copy todir="${project.build.directory}/client-package-input">
                                            <fileset dir="${project.build.directory}/libs"/>
                                        </copy>
                                        <mkdir dir="${project.build.directory}/server-package-input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/server-package-input/server.jar"/>
                                        <copy todir="${project.build.directory}/server-package-input">
                                            <fileset dir="${project.build.directory}/libs"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-client</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>app-image</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/client-package-input</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--name</argument><argument>HeThongDauGiaClient</argument>
                                        <argument>--main-jar</argument><argument>client.jar</argument>
                                        <argument>--main-class</argument><argument>view.Launcher</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--app-version</argument><argument>${project.version.clean}</argument>
                                        <!-- Thông số bắt buộc cho MacOS -->
                                        <argument>--mac-package-identifier</argument><argument>com.hethongdaugia.client</argument>
                                        <argument>--mac-package-name</argument><argument>HeThongDauGiaClient</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-server</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>app-image</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/server-package-input</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--name</argument><argument>HeThongDauGiaServer</argument>
                                        <argument>--main-jar</argument><argument>server.jar</argument>
                                        <argument>--main-class</argument><argument>server.AuctionServer</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--app-version</argument><argument>${project.version.clean}</argument>
                                        <!-- Thông số bắt buộc cho MacOS -->
                                        <argument>--mac-package-identifier</argument><argument>com.hethongdaugia.server</argument>
                                        <argument>--mac-package-name</argument><argument>HeThongDauGiaServer</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties><project.version.clean>1.0.0</project.version.clean></properties>
        </profile>
        <!-- PROFILE CHO LINUX -->
        <profile>
            <id>package-linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/client-package-input" quiet="true"/>
                                        <delete dir="${project.build.directory}/server-package-input" quiet="true"/>
                                        <delete dir="${project.build.directory}/dist" quiet="true"/>
                                        <mkdir dir="${project.build.directory}/client-package-input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/client-package-input/client.jar"/>
                                        <copy todir="${project.build.directory}/client-package-input">
                                            <fileset dir="${project.build.directory}/libs"/>
                                        </copy>
                                        <mkdir dir="${project.build.directory}/server-package-input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/server-package-input/server.jar"/>
                                        <copy todir="${project.build.directory}/server-package-input">
                                            <fileset dir="${project.build.directory}/libs"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-client</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>deb</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/client-package-input</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--name</argument><argument>HeThongDauGiaClient</argument>
                                        <argument>--main-jar</argument><argument>client.jar</argument>
                                        <argument>--main-class</argument><argument>view.Launcher</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--app-version</argument><argument>${project.version.clean}</argument>
                                        <argument>--linux-shortcut</argument>
                                        <argument>--linux-menu-group</argument><argument>Utility</argument>
                                        <argument>--linux-deb-maintainer</argument><argument>admin@hethongdaugia.com</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-server</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>deb</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/server-package-input</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--name</argument><argument>HeThongDauGiaServer</argument>
                                        <argument>--main-jar</argument><argument>server.jar</argument>
                                        <argument>--main-class</argument><argument>server.AuctionServer</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--app-version</argument><argument>${project.version.clean}</argument>
                                        <argument>--linux-deb-maintainer</argument><argument>admin@hethongdaugia.com</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties><project.version.clean>1.0.0</project.version.clean></properties>
        </profile>
    </profiles>
</project>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="500.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.SellerUI.CreateItemController">
    <children>
        <Label layoutX="107.0" layoutY="35.0" text="TẠO PHIÊN ĐẤU GIÁ MỚI" textFill="#ea7f33">
            <font>
                <Font name="Segoe UI Black" size="24.0" />
            </font>
        </Label>
        <VBox layoutX="70.0" layoutY="100.0" prefHeight="250.0" prefWidth="360.0" spacing="15.0">
            <children>
                <Label text="Tên sản phẩm:">
                    <font><Font name="Segoe UI Bold" size="14.0" /></font>
                </Label>
                <TextField fx:id="txtItemName" prefHeight="35.0" promptText="VD: Đồng hồ Rolex cổ" />

                <Label text="Giá khởi điểm ($):">
                    <font><Font name="Segoe UI Bold" size="14.0" /></font>
                </Label>
                <TextField fx:id="txtStartPrice" prefHeight="35.0" promptText="VD: 5000" />

                <Label text="Thời gian đấu giá (Phút):">
                    <font><Font name="Segoe UI Bold" size="14.0" /></font>
                </Label>
                <TextField fx:id="txtDuration" prefHeight="35.0" promptText="VD: 30" />

                <Button mnemonicParsing="false" onAction="#createItemButtonClicked" prefHeight="45.0" prefWidth="360.0" style="-fx-background-color: #ea7f33; -fx-background-radius: 10;" text="ĐĂNG BÁN" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="16.0" />
                    </font>
                </Button>

                <Button mnemonicParsing="false" onAction="#cancelButtonClicked" prefHeight="35.0" prefWidth="360.0" style="-fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-radius: 10;" text="Hủy bỏ, quay lại" />
            </children>
        </VBox>
    </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="1050.0" style="-fx-background-color: #f5f5f0;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controller.menu.BaseMenuController">
   <children>

      <!-- ========== MAIN SCROLLABLE CONTENT ========== -->
      <ScrollPane fitToHeight="false" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
         <content>
            <VBox fillWidth="true" spacing="0" style="-fx-background-color: transparent;">

               <!-- ===== HERO BANNER ===== -->
               <StackPane prefHeight="300.0" style="-fx-background-color: linear-gradient(to bottom right, #1a1a1a, #2d2318);">
                  <!-- Background image overlay -->
                  <ImageView fitHeight="300.0" fitWidth="1050.0" opacity="0.25" pickOnBounds="true" preserveRatio="false" StackPane.alignment="CENTER" />
                  <!-- Gradient overlay for readability -->
                  <Pane style="-fx-background-color: linear-gradient(to right, rgba(26,26,26,0.85) 0%, rgba(26,26,26,0.5) 50%, transparent 100%);" />
                  <!-- Banner content -->
                  <VBox alignment="CENTER_LEFT" spacing="10" StackPane.alignment="CENTER_LEFT">
                     <padding><Insets bottom="40" left="50" right="50" top="40" /></padding>
                     <children>
                        <Label style="-fx-text-fill: #d4cd3d; -fx-font-size: 13px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="⚡ HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" />
                        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 34px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI'; -fx-line-spacing: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 6, 0, 0, 3);" text="Nền Tảng Đấu Giá&#10;Minh Bạch &amp; Hiện Đại" wrapText="true" />
                        <Label style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 14px; -fx-font-family: 'Segoe UI';" text="Đăng sản phẩm, đặt giá khởi điểm và theo dõi phiên đấu giá trong thời gian thực." wrapText="true">
                           <VBox.margin><Insets bottom="8" top="2" /></VBox.margin>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                           <children>
                              <Button mnemonicParsing="false" onAction="#joinBidding" style="-fx-background-color: linear-gradient(to right, #ea7f33, #d46b20); -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI'; -fx-background-radius: 25; -fx-padding: 12 30; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(234,127,51,0.5), 14, 0, 0, 4);" text="🔥 THAM GIA ĐẤU GIÁ">
                                 <tooltip><javafx.scene.control.Tooltip text="Tham gia vào phiên đấu giá được chọn" /></tooltip>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#goToAssetsListButtonClicked" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 10 24; -fx-cursor: hand;" text="📋 Xem Tài Sản" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </StackPane>

               <!-- ===== QUICK STATS BAR ===== -->
               <HBox alignment="CENTER" spacing="0" style="-fx-background-color: #ffffff; -fx-border-color: #e8e8e0; -fx-border-width: 0 0 1 0;">
                  <children>
                     <VBox alignment="CENTER" spacing="2" style="-fx-padding: 16 10;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label style="-fx-font-size: 20px;" text="🏷️" />
                           <Label style="-fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="Đa Dạng Danh Mục" />
                           <Label style="-fx-text-fill: #999999; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="Điện tử • Xe cộ • Nghệ thuật" />
                        </children>
                     </VBox>
                     <Separator orientation="VERTICAL" />
                     <VBox alignment="CENTER" spacing="2" style="-fx-padding: 16 10;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label style="-fx-font-size: 20px;" text="⚡" />
                           <Label style="-fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="Cập Nhật Realtime" />
                           <Label style="-fx-text-fill: #999999; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="Giá mới hiển thị tức thì" />
                        </children>
                     </VBox>
                     <Separator orientation="VERTICAL" />
                     <VBox alignment="CENTER" spacing="2" style="-fx-padding: 16 10;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label style="-fx-font-size: 20px;" text="🔒" />
                           <Label style="-fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="Bảo Mật Cao" />
                           <Label style="-fx-text-fill: #999999; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="Giao dịch an toàn" />
                        </children>
                     </VBox>
                     <Separator orientation="VERTICAL" />
                     <VBox alignment="CENTER" spacing="2" style="-fx-padding: 16 10;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label style="-fx-font-size: 20px;" text="🤝" />
                           <Label style="-fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="Minh Bạch" />
                           <Label style="-fx-text-fill: #999999; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';" text="Lịch sử đấu giá công khai" />
                        </children>
                     </VBox>
                  </children>
               </HBox>

               <!-- ===== GIỚI THIỆU SECTION ===== -->
               <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #f5f5f0; -fx-padding: 30 40;">
                  <children>
                     <Label style="-fx-text-fill: #ea7f33; -fx-font-size: 12px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="VỀ CHÚNG TÔI" />
                     <Label style="-fx-text-fill: #1a1a1a; -fx-font-size: 26px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="Giới Thiệu Dự Án" />
                     <Separator prefWidth="60.0">
                        <VBox.margin><Insets bottom="2" top="2" /></VBox.margin>
                     </Separator>
                     <Label style="-fx-text-fill: #666666; -fx-font-size: 14px; -fx-font-family: 'Segoe UI'; -fx-text-alignment: center;" text="Đây là sản phẩm được tạo ra bởi Nhóm 6. Nhóm chúng tôi gồm 4 thành viên, mỗi người đảm nhận một vai trò riêng biệt: phát triển backend, frontend, thiết kế giao diện và kiểm thử hệ thống." wrapText="true" />
                     <Label style="-fx-text-fill: #666666; -fx-font-size: 14px; -fx-font-family: 'Segoe UI'; -fx-text-alignment: center;" text="Ứng dụng cho phép người dùng đăng sản phẩm, thiết lập giá khởi điểm và theo dõi phiên đấu giá theo thời gian thực một cách minh bạch, tiện lợi." wrapText="true" />
                  </children>
               </VBox>

               <!-- ===== AUCTION TABLE SECTION ===== -->
               <VBox spacing="14" style="-fx-background-color: #ffffff; -fx-padding: 24 40 40 40;" VBox.vgrow="ALWAYS">
                  <children>
                     <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <VBox spacing="2">
                              <children>
                                 <Label style="-fx-text-fill: #1a1a1a; -fx-font-size: 20px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="🔥 Phiên Đấu Giá Đang Diễn Ra" />
                                 <Label style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';" text="Nhấp đúp vào hàng để tham gia phiên đấu giá" />
                              </children>
                           </VBox>
                           <Region HBox.hgrow="ALWAYS" />
                           <Button mnemonicParsing="false" onAction="#joinBidding" styleClass="btn-accent" text="+ Tham Gia Ngay">
                              <tooltip><javafx.scene.control.Tooltip text="Tham gia vào phiên đấu giá đang chọn ở bảng dưới" /></tooltip>
                           </Button>
                        </children>
                     </HBox>
                     <TableView fx:id="tableAuctions" minHeight="400.0" prefHeight="400.0" VBox.vgrow="ALWAYS">
                        <placeholder><Label styleClass="placeholder-label" text="Chưa có phiên đấu giá nào đang diễn ra" /></placeholder>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                           <TableColumn fx:id="colId" prefWidth="100.0" text="Mã Phiên" />
                           <TableColumn fx:id="colName" prefWidth="130.0" text="Tên Tài Sản" />
                           <TableColumn fx:id="colDescription" prefWidth="160.0" text="Mô Tả" />
                           <TableColumn fx:id="colType" prefWidth="100.0" text="Loại Sản Phẩm" />
                           <TableColumn fx:id="colPrice" prefWidth="100.0" text="Giá Hiện Tại" />
                           <TableColumn fx:id="colBidCount" prefWidth="70.0" text="Số Lượt Đặt" />
                           <TableColumn fx:id="colHighestBidder" prefWidth="100.0" text="Người Giữ Giá" />
                           <TableColumn fx:id="colEndTime" prefWidth="110.0" text="Thời Gian" />
                           <TableColumn fx:id="colStatus" prefWidth="100.0" text="Trạng Thái" />
                           <TableColumn fx:id="colSeller" prefWidth="90.0" text="Người Bán" />
                        </columns>
                     </TableView>
                  </children>
               </VBox>

            </VBox>
         </content>
      </ScrollPane>

      <!-- ========== DARK OVERLAY ========== -->
      <Pane fx:id="darkOverlay" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

      <!-- ========== NOTIFICATION SIDE PANEL ========== -->
      <ScrollPane fx:id="notificationMenu" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefWidth="400.0" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
         <content>
            <VBox spacing="0" style="-fx-background-color: #ffffff;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a1a1a; -fx-padding: 16 14;">
                     <children>
                        <Label style="-fx-text-fill: #d4cd3d; -fx-font-size: 16px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="🔔 Thông báo" />
                     </children>
                  </HBox>
                  <Separator />
                  <TableView fx:id="tableNotifications" VBox.vgrow="ALWAYS">
                     <placeholder><Label styleClass="placeholder-label" text="Chưa có thông báo" /></placeholder>
                     <columns>
                        <TableColumn fx:id="colNotifContent" prefWidth="280.0" text="Nội dung" />
                        <TableColumn fx:id="colNotifTime" prefWidth="116.0" text="Thời gian" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- ========== TOP NAVIGATION BAR ========== -->
      <HBox fx:id="menuBar" alignment="CENTER_LEFT" prefHeight="60.0" styleClass="nav-bar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label style="-fx-text-fill: #d4cd3d; -fx-font-size: 20px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI'; -fx-padding: 0 20 0 20; -fx-effect: dropshadow(gaussian, rgba(212,205,61,0.3), 6, 0, 0, 0);" text="⚡ ĐẤU GIÁ" />
            <Separator orientation="VERTICAL" prefHeight="30.0" />
            <Button mnemonicParsing="false" prefHeight="60.0" styleClass="nav-btn-active" text="🏠 Trang Chủ" />
            <MenuButton alignment="CENTER" mnemonicParsing="false" prefHeight="60.0" text="📦 Tài Sản">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#goToAssetsListButtonClicked" text="Danh sách tài sản" />
                  <MenuItem mnemonicParsing="false" onAction="#openChoiceMenu" text="Đấu giá mới" />
               </items>
            </MenuButton>
            <Button mnemonicParsing="false" onAction="#notificationClicked" prefHeight="60.0" styleClass="nav-btn" text="🔔 Thông Báo" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="txtBalance" style="-fx-text-fill: #d4cd3d; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-padding: 6 12; -fx-background-color: rgba(212,205,61,0.1); -fx-background-radius: 20;" text="💰 Số dư: $0" />
            <Region prefWidth="6.0" />
            <Button fx:id="btnTransaction" mnemonicParsing="false" onAction="#handleTransaction" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 12; -fx-cursor: hand;" text="Nạp/Rút" />
            <Region prefWidth="6.0" />
            <MenuButton alignment="CENTER" mnemonicParsing="false" prefHeight="60.0" text="👤 Tài Khoản">
                <items>
                   <MenuItem mnemonicParsing="false" onAction="#openProfile" text="Thông tin cá nhân" />
                   <MenuItem mnemonicParsing="false" onAction="#backToLoiginButtonClicked" text="Đăng xuất" />
                   <MenuItem mnemonicParsing="false" onAction="#backToRegisterButtonClicked" text="Đăng ký tài khoản mới" />
                </items>
            </MenuButton>
            <Region prefWidth="10.0" />
         </children>
      </HBox>

   </children>
</AnchorPane>

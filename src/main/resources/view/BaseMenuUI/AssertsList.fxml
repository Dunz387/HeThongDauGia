<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="1050.0" style="-fx-background-color: #f5f5f0;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.BaseMenuUI.AssertsListController">
   <children>

      <!-- ========== MAIN CONTENT AREA ========== -->
      <VBox spacing="0" style="-fx-background-color: #f5f5f0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">

         <!-- ===== PAGE HEADER BANNER ===== -->
         <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #1a1a1a; -fx-padding: 28 40;">
            <children>
               <VBox spacing="4" HBox.hgrow="ALWAYS">
                  <children>
                     <Label style="-fx-text-fill: #ffffff; -fx-font-size: 24px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="📋 Danh Sách Tài Sản" />
                     <Label style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="Quản lý và theo dõi tất cả tài sản trong hệ thống đấu giá" />
                  </children>
               </VBox>
               <Button mnemonicParsing="false" onAction="#joinNewBidding" style="-fx-background-color: linear-gradient(to right, #ea7f33, #d46b20); -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI'; -fx-background-radius: 25; -fx-padding: 10 28; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(234,127,51,0.4), 10, 0, 0, 3);" text="+ Đấu Giá Mới" />
            </children>
         </HBox>

         <!-- ===== STAT CHIPS BAR ===== -->
         <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #ffffff; -fx-padding: 14 40; -fx-border-color: #e8e8e0; -fx-border-width: 0 0 1 0;">
            <children>
               <Label style="-fx-text-fill: #ea7f33; -fx-font-size: 13px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI'; -fx-padding: 4 14; -fx-background-color: rgba(234,127,51,0.1); -fx-background-radius: 16;" text="🏷️ Tất cả sản phẩm" />
               <Separator orientation="VERTICAL" prefHeight="20.0" />
               <Label style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';" text="🔌 Đồ điện" />
               <Label style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';" text="🚗 Xe cộ" />
               <Label style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-font-family: 'Segoe UI';" text="🎨 Nghệ thuật" />
               <Region HBox.hgrow="ALWAYS" />
               <Button mnemonicParsing="false" onAction="#goToAssertsListButtonClicked" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-border-color: #d0d0d0; -fx-border-radius: 16; -fx-background-radius: 16; -fx-padding: 4 14; -fx-cursor: hand;" text="🔄 Làm Mới" />
            </children>
         </HBox>

         <!-- ===== TABLE CARD ===== -->
         <VBox style="-fx-padding: 20 40;" VBox.vgrow="ALWAYS">
            <children>
               <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 14; -fx-padding: 0; -fx-border-color: #e8e8e0; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                  <children>
                     <TableView fx:id="tableAsserts" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                           <TableColumn fx:id="colSTT" prefWidth="70.0" text="STT" />
                           <TableColumn fx:id="colItemName" prefWidth="280.0" text="Tên Sản Phẩm" />
                           <TableColumn fx:id="colType" prefWidth="200.0" text="Loại Sản Phẩm" />
                           <TableColumn fx:id="colId" prefWidth="300.0" text="Mã Sản Phẩm" />
                        </columns>
                     </TableView>
                  </children>
               </VBox>
            </children>
         </VBox>

      </VBox>

      <!-- ========== DARK OVERLAY ========== -->
      <Pane fx:id="darkOverlay" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

      <!-- ========== NOTIFICATION SIDE PANEL ========== -->
      <ScrollPane fx:id="notificationMenu" fitToWidth="true" hbarPolicy="NEVER" prefHeight="620.0" prefWidth="300.0" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
         <content>
            <VBox spacing="0" style="-fx-background-color: #ffffff;">
               <children>
                  <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1a1a1a; -fx-padding: 16 14;">
                     <children>
                        <Label style="-fx-text-fill: #d4cd3d; -fx-font-size: 16px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" text="🔔 Thông Báo" />
                     </children>
                  </HBox>
                  <Separator />
                  <TableView prefHeight="500.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn prefWidth="180.0" text="Nội dung" />
                        <TableColumn prefWidth="116.0" text="Thời gian" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- ========== TOP NAVIGATION BAR ========== -->
      <HBox fx:id="menuBar" alignment="CENTER_LEFT" prefHeight="60.0" styleClass="nav-bar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label style="-fx-text-fill: #d4cd3d; -fx-font-size: 20px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI'; -fx-padding: 0 20 0 20; -fx-effect: dropshadow(gaussian, rgba(212,205,61,0.3), 6, 0, 0, 0);" text="⚡ ĐẤU GIÁ" />
            <Separator orientation="VERTICAL" prefHeight="30.0" />
            <Button mnemonicParsing="false" onAction="#backToBaseMenuButtonClicked" prefHeight="60.0" styleClass="nav-btn" text="🏠 Trang Chủ" />
            <MenuButton alignment="CENTER" mnemonicParsing="false" prefHeight="60.0" text="📦 Tài Sản">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#goToAssertsListButtonClicked" text="Làm mới danh sách" />
                  <MenuItem mnemonicParsing="false" onAction="#joinNewBidding" text="Đấu giá mới" />
               </items>
            </MenuButton>
            <Button mnemonicParsing="false" onAction="#toggleNotificationMenu" prefHeight="60.0" styleClass="nav-btn" text="🔔 Thông Báo" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #d4cd3d; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-padding: 6 12; -fx-background-color: rgba(212,205,61,0.1); -fx-background-radius: 20;" text="💰 Số dư: $100,000" />
            <Region prefWidth="6.0" />
            <MenuButton alignment="CENTER" mnemonicParsing="false" prefHeight="60.0" text="👤 Tài Khoản">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#backToLoiginButtonClicked" text="Đăng xuất" />
                  <MenuItem mnemonicParsing="false" onAction="#backToRegisterButtonClicked" text="Đăng ký tài khoản mới" />
               </items>
            </MenuButton>
            <Region prefWidth="10.0" />
         </children>
      </HBox>

   </children>
</AnchorPane>

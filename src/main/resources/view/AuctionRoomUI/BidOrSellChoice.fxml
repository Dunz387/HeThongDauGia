<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="420.0" prefWidth="560.0" style="-fx-background-color: #ffffff;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.AuctionRoomUI.BidOrSellChoiceController">
   <children>
      <VBox alignment="CENTER" spacing="18" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.bottomAnchor="30">
         <children>
            <Label text="Bạn muốn làm gì?" style="-fx-text-fill: #1a1a1a; -fx-font-size: 26px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" />
            <Label text="Chọn một hành động để tiếp tục" style="-fx-text-fill: #888888; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';">
               <VBox.margin><Insets bottom="8" /></VBox.margin>
            </Label>

            <HBox alignment="CENTER" spacing="24">
               <children>
                  <!-- SELL -->
                  <Button mnemonicParsing="false" onAction="#SellChoiceClicked" prefHeight="200.0" prefWidth="220.0" contentDisplay="GRAPHIC_ONLY" style="-fx-background-color: #faf9f0; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e8e8e0; -fx-border-width: 2; -fx-cursor: hand;">
                     <graphic>
                        <VBox alignment="CENTER" spacing="10" prefWidth="180.0">
                           <children>
                              <Pane prefHeight="56.0" prefWidth="56.0" style="-fx-background-color: rgba(212,205,61,0.2); -fx-background-radius: 28;">
                                 <children>
                                    <Label text="💰" layoutX="12.0" layoutY="8.0" style="-fx-font-size: 26px;" />
                                 </children>
                              </Pane>
                              <Label text="Bán sản phẩm" style="-fx-text-fill: #1a1a1a; -fx-font-size: 18px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" />
                              <Label text="Đăng sản phẩm lên sàn" style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-alignment: center;" wrapText="true" />
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- BID -->
                  <Button mnemonicParsing="false" onAction="#BidChoiceClicked" prefHeight="200.0" prefWidth="220.0" contentDisplay="GRAPHIC_ONLY" style="-fx-background-color: #faf9f0; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e8e8e0; -fx-border-width: 2; -fx-cursor: hand;">
                     <graphic>
                        <VBox alignment="CENTER" spacing="10" prefWidth="180.0">
                           <children>
                              <Pane prefHeight="56.0" prefWidth="56.0" style="-fx-background-color: rgba(234,127,51,0.15); -fx-background-radius: 28;">
                                 <children>
                                    <Label text="🔥" layoutX="12.0" layoutY="8.0" style="-fx-font-size: 26px;" />
                                 </children>
                              </Pane>
                              <Label text="Đấu giá" style="-fx-text-fill: #1a1a1a; -fx-font-size: 18px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI';" />
                              <Label text="Tham gia phòng đấu giá" style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-alignment: center;" wrapText="true" />
                           </children>
                        </VBox>
                     </graphic>
                  </Button>
               </children>
            </HBox>

            <Button mnemonicParsing="false" onAction="#backToMenu" styleClass="btn-secondary" text="← Quay lại" prefWidth="200.0">
               <VBox.margin><Insets top="4" /></VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>